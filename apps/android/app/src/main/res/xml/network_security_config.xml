<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is retained only because the app explicitly supports user-entered
         LAN/Tailscale ws:// endpoints. No remote endpoint is bundled or trusted here. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
